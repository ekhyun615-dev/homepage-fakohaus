RewriteEngine On

# non-www → www 통합 (중복 색인 방지)
# 호스트가 www 로 바뀌면 조건이 더 이상 맞지 않으므로 루프가 생기지 않는다.
RewriteCond %{HTTP_HOST} ^fakohaus\.kr$ [NC]
RewriteRule ^(.*)$ https://www.fakohaus.kr/$1 [R=301,L]

# HTTPS 강제는 켜지 않는다.
# 카페24가 엣지(openresty)에서 http→https 를 이미 301 로 처리하고 있고,
# 엣지가 Apache 로 넘길 때 HTTPS=on / X-Forwarded-Proto 를 주는지 확인할 수
# 없다. 둘 다 없는 구성이면 아래 규칙이 무한 리다이렉트를 만들어 사이트가
# 통째로 막힌다. 카페24 쪽 처리가 사라졌을 때만 주석을 풀 것.
#
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !=https
# RewriteRule ^(.*)$ https://www.fakohaus.kr/$1 [R=301,L]

ErrorDocument 404 /404.html

DirectoryIndex index.html
Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # 파일명이 고정된 자산은 길게, HTML은 짧게
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType application/pdf         "access plus 1 month"
  ExpiresByType text/html               "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header always append X-Frame-Options SAMEORIGIN
</IfModule>

AddType image/webp .webp
AddDefaultCharset UTF-8
