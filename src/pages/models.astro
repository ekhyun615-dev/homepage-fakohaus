---

<BaseLayout
  title="주택모델 | FAKOHAUS"
  description="20평형부터 50평형까지, FAKOHAUS 표준주택 11개 모델. ALC 또는 POROTON 골조로 선택 시공 가능한 독일식 표준 설계."
>
  <div class="sub-hero">
    <div class="wrap">
      <div class="crumb">Home / 주택모델</div>
      <h1>주택모델</h1>
      <p>독일식 표준 설계를 국내 주거환경에 맞게 최적화한 FAKOHAUS 주택모델입니다. 20평형부터 50평형까지 11개 모델을 만나보실 수 있으며, 모든 모델은 ALC 또는 POROTON 골조로 선택 시공이 가능합니다.</p>
    </div>
  </div>
  <div class="wrap">
    <div class="tabs">
      {models.map((m, i) => (
        <button data-tab={m.id} class={i === 0 ? 'on' : ''}>{m.name}</button>
      ))}
    </div>
  </div>

  {models.map((m, i) => (
    <div class={`tabpane${i === 0 ? ' on' : ''}`} data-pane={m.id}>
      <div class="sec">
        <div class={`wrap split${i % 2 === 1 ? ' rev' : ''}`}>
          <div class="media">
            <img src={m.hero} alt={m.name} loading="lazy" />
          </div>
          <div>
            <span class="eyebrow">{m.eyebrow}</span>
            <h3>{m.headline}</h3>
            <p>{m.body}</p>
            <ul class="checks">
              {m.checks.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
            <div style="margin-top:30px;display:flex;gap:12px;flex-wrap:wrap">
              <a class="btn btn-primary" href="/contact">이 모델로 상담하기</a>
              <a class="btn btn-ghost" href="/downloads#catalog">도면 자료 받기</a>
            </div>
          </div>
        </div>
      </div>
      <div class="sec tint" style="padding-top:0;background:transparent">
        <div class="wrap">
          <span class="eyebrow">Grunddaten</span>
          <h3 style="font-size:24px;margin-bottom:22px">기본 사양</h3>
          <table class="spec-table">
            {m.specs.map(([k, v]) => (
              <tr>
                <th>{k}</th>
                <td>{v}</td>
              </tr>
            ))}
          </table>
        </div>
      </div>
      {m.plans.length > 0 && (
        <div class="sec" style="padding-top:0">
          <div class="wrap">
            <span class="eyebrow">Grundriss</span>
            <h3 style="font-size:24px;margin-bottom:22px">평면도</h3>
            <div class="model-plans">
              {m.plans.map((p) => (
                <figure>
                  <img src={p.src} alt={`${m.name} ${p.label}`} loading="lazy" />
                  <figcaption>{p.label}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
      )}
      {m.exterior && m.exterior.length > 0 && (
        <div class="sec tint" style="padding-top:0;background:transparent">
          <div class="wrap">
            <span class="eyebrow">Außenansicht</span>
            <h3 style="font-size:24px;margin-bottom:22px">외부 이미지</h3>
            <div class="model-gallery model-gallery--exterior">
              {m.exterior.map((g) => {
                const item = galleryItem(g, `${m.name} 외부 이미지`);
                return (
                  <figure>
                    <img src={item.src} alt={item.caption} loading="lazy" />
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                );
              })}
            </div>
          </div>
        </div>
      )}
      {m.gallery.length > 0 && (
        <div class="sec" style="padding-top:0">
          <div class="wrap">
            <span class="eyebrow">Innenansicht</span>
            <h3 style="font-size:24px;margin-bottom:22px">내부 이미지</h3>
            <div class="model-gallery">
              {m.gallery.map((g) => {
                const item = galleryItem(g, `${m.name} 내부 이미지`);
                return (
                  <figure>
                    <img src={item.src} alt={item.caption} loading="lazy" />
                    <figcaption>{item.caption}</figcaption>
                  </figure>
                );
              })}
            </div>
          </div>
        </div>
      )}
    </div>
  ))}
</BaseLayout>
