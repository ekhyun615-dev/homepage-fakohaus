import BaseLayout from '../layouts/BaseLayout.astro';

type Spec = [string, string];
type GalleryItem = string | { src: string; caption: string };
type Model = {
  id: string;
  eyebrow: string;
  name: string;
  headline: string;
  body: string;
  checks: string[];
  specs: Spec[];
  hero: string;
  plans: { label: string; src: string }[];
  exterior?: GalleryItem[];
  gallery: GalleryItem[];
};

const galleryItem = (g: GalleryItem, fallback: string) =>
  typeof g === 'string' ? { src: g, caption: fallback } : g;

const models: Model[] = [
  {
    id: '25a',
    eyebrow: 'Modell 25A · 20평형',
