---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/site';

// 상담 신청은 FormSubmit.co 를 통해 info@alcmate.com 으로 전달됩니다.
// (별도 가입 불필요 · 최초 1회 확인 이메일 인증 후 활성화 — Gaulhofer/CREATON Korea 사이트와 동일 방식)
const FORM_ENDPOINT = `https://formsubmit.co/${company.email}`;
---

<BaseLayout
  title="상담 문의 | FAKOHAUS"
  description="부지·예산·희망 골조를 알려주시면 40년 경력의 전문가가 직접 답변드립니다."
>
  <div class="sub-hero">
    <div class="wrap">
      <div class="crumb">Home / 상담 문의</div>
      <h1>상담 문의</h1>
      <p>부지·예산·희망 골조를 알려주시면 40년 경력의 전문가가 직접 답변드립니다.</p>
    </div>
  </div>
  <div class="sec"><div class="wrap">
    <div class="contact-grid">
      <div class="cinfo">
        <div class="row"><div class="ic">전화</div><div><b>{company.tel}</b><small>{company.hours} · 가장 빠른 상담</small></div></div>
        <div class="row"><div class="ic">카톡</div><div><b>카카오톡 채널 상담</b><small>사진·도면 첨부가 필요하면 카카오톡이 편리합니다</small></div></div>
        <div class="row"><div class="ic">메일</div><div><b>{company.email}</b><small>기술 문의·자재 견적 요청</small></div></div>
        <div class="row"><div class="ic">방문</div><div><b>전시실 방문 상담 (예약제)</b><small>{company.address}</small></div></div>
      </div>
      <div class="form">
        <h3>건축 상담 신청</h3>
        <div class="sub">영업일 기준 1일 이내에 연락드립니다.</div>
        <form id="contact-form" action={FORM_ENDPOINT} method="POST">
          <input type="hidden" name="_subject" value="[FAKOHAUS] 새 상담 신청" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_next" value="/contact/thanks" data-next-path="/contact/thanks" />
          <input type="hidden" name="_captcha" value="false" />
          <!-- 스팸 봇 트랩 (사람에겐 보이지 않음) -->
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

          <div class="f2">
            <div class="fld"><label for="f-name">성함 <span>*</span></label><input id="f-name" name="name" type="text" required placeholder="홍길동"></div>
            <div class="fld"><label for="f-tel">연락처 <span>*</span></label><input id="f-tel" name="phone" type="tel" required placeholder="010-0000-0000"></div>
          </div>
          <div class="f2">
            <div class="fld"><label for="f-region">건축 예정 지역</label><input id="f-region" name="region" type="text" placeholder="예) 경기 양평"></div>
            <div class="fld"><label for="f-type">관심 골조</label><select id="f-type" name="frame_type"><option>미정 / 상담 후 결정</option><option>ALC주택</option><option>POROTON주택</option></select></div>
          </div>
          <div class="fld"><label for="f-msg">문의 내용</label><textarea id="f-msg" name="message" placeholder="부지 조건, 희망 평수, 예산 범위 등을 자유롭게 적어주세요."></textarea></div>
          <label class="agree">
            <input type="checkbox" name="privacy" required />
            <span>개인정보 수집 및 이용에 동의합니다. (상담 목적 외 사용하지 않습니다.)</span>
          </label>
          <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center">상담 신청하기</button>
          <p class="form-note">
            제출이 어려우신 경우 <a href={`tel:${company.tel}`}>{company.tel}</a> 또는
            <a href={`mailto:${company.email}`}>{company.email}</a> 로 문의해 주세요.
          </p>
        </form>
      </div>
    </div>
  </div></div>
</BaseLayout>

<script>
  // 폼 제출 후 이동할 완료 페이지를 현재 도메인 기준 절대경로로 설정
  const next = document.querySelector<HTMLInputElement>('input[name="_next"][data-next-path]');
  if (next) next.value = window.location.origin + (next.dataset.nextPath ?? '/contact/thanks');
</script>
