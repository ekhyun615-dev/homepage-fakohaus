---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const infoPosts: CollectionEntry<'info'>[] = (await getCollection('info')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const infoCategories = [...new Set(infoPosts.map((p) => p.data.category))];
---

<BaseLayout
  title="Download | FAKOHAUS"
  description="독일 CREATON 점토기와, GAULHOFER 창호·현관문, POROTON 주택, Caparol 친환경 마감재 카탈로그 5종과 POROTON 블록·조적용 몰탈 기술자료(TDS) 6종을 PDF로 무료 제공합니다. ALC·POROTON 시공 기술정보도 함께 보실 수 있습니다."
>
  <div class="sub-hero">
    <div class="wrap">
      <div class="crumb">Home / Download</div>
      <h1>Download</h1>
      <p>카탈로그·기술자료·기술정보를 PDF로 제공합니다. 계약 전 충분히 검토하시고 궁금한 점은 언제든 문의하세요.</p>
    </div>
  </div>
  <div class="wrap">
    <div class="tabs">
      <button data-tab="catalog" class="on">카탈로그</button>
      <button data-tab="tech">기술자료</button>
      <button data-tab="info">기술정보</button>
    </div>
  </div>

  <div class="tabpane on" data-pane="catalog">
    <div class="sec"><div class="wrap">
      <div class="dl-list">
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>CREATON 점토기와 카탈로그</b><small>기와 라인업 · 컬러 · 액세서리</small></div><a class="btn btn-primary" href="/downloads/creaton-catalog-2024.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>GAULHOFER 창호 카탈로그</b><small>시스템창호 · 현관문 · 리프트슬라이딩 도어</small></div><a class="btn btn-primary" href="/downloads/gaulhofer-catalog-2016.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>GAULHOFER 원목 현관문 카탈로그</b><small>원목 현관문 라인업 · 사양</small></div><a class="btn btn-primary" href="/downloads/gaulhofer-wood-door-catalog.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>독일 POROTON 주택 카탈로그</b><small>세라믹 점토블록 주택 소개 (한글판)</small></div><a class="btn btn-primary" href="/downloads/poroton-haus-catalog-kor.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>독일 친환경 인테리어 마감재 카파그린 카탈로그</b><small>Caparol CapaGreen 라인업 (한글번역본)</small></div><a class="btn btn-primary" href="/downloads/capagreen-interior-catalog-kor.pdf" download>다운로드</a></div>
      </div>
    </div></div>
  </div>

  <div class="tabpane" data-pane="tech">
    <div class="sec"><div class="wrap">
      <div class="dl-list">
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>POROTON HLz-Plan-T 기술자료</b><small>12-0.9-17.5 규격 정밀블럭 TDS</small></div><a class="btn btn-primary" href="/downloads/poroton-hlz-plan-t-12-09-175-tds.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>POROTON T7-36.5-P 기술자료</b><small>퍼라이트 충진형 365mm 블록 TDS</small></div><a class="btn btn-primary" href="/downloads/poroton-t7-365-p-tds.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>POROTON Plan-T9-36 기술자료</b><small>정밀블럭 T9, 365mm TDS</small></div><a class="btn btn-primary" href="/downloads/poroton-plan-t9-36-tds.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>POROTON Plan-T10-30 기술자료</b><small>정밀블럭 T10, 300mm TDS</small></div><a class="btn btn-primary" href="/downloads/poroton-plan-t10-30-tds.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>Maxit 825 Therm 기술자료</b><small>POROTON 단열 조적용 몰탈 TDS</small></div><a class="btn btn-primary" href="/downloads/maxit-825-therm-tds.pdf" download>다운로드</a></div>
        <div class="dl"><div class="ic">PDF</div><div class="tx"><b>Dünnbettmörtel Typ M IV 기술자료</b><small>박막 조적용 몰탈 TDS</small></div><a class="btn btn-primary" href="/downloads/duennbettmoertel-m4-tds.pdf" download>다운로드</a></div>
      </div>
    </div></div>
  </div>

  <div class="tabpane" data-pane="info">
    <div class="sec"><div class="wrap">
      <div class="info-toolbar">
        <select id="info-cat">
          <option value="all">카테고리 전체</option>
          {infoCategories.map((c) => <option value={c}>{c}</option>)}
        </select>
        <input id="info-search" type="text" placeholder="제목으로 검색" />
      </div>
      <div class="info-list" id="info-list">
        {infoPosts.map((post) => (
          <a class="info-row" href={`/info/${post.slug}`} data-cat={post.data.category} data-title={post.data.title}>
            <span class="cat">{post.data.category}</span>
            <span class="ttl">{post.data.title}</span>
          </a>
        ))}
      </div>
      <p class="info-empty" id="info-empty" style="display:none">검색 결과가 없습니다.</p>
      <div class="faq" style="margin-top:56px">
        <details><summary>자료는 누구나 볼 수 있나요?</summary><div class="a">네. 모든 기술정보는 예비 건축주님을 위해 무료로 공개합니다. 상세 견적 자료는 상담 후 별도 제공됩니다.</div></details>
        <details><summary>더 궁금한 내용은 어디서 물어볼 수 있나요?</summary><div class="a">문의 페이지를 통해 남겨주시면 담당자가 확인 후 답변드립니다.</div></details>
      </div>
    </div></div>
  </div>
</BaseLayout>

<script>
  // 기술정보 목록 카테고리·검색 필터
  const catSel = document.getElementById('info-cat') as HTMLSelectElement | null;
  const searchInput = document.getElementById('info-search') as HTMLInputElement | null;
  const rows = document.querySelectorAll<HTMLElement>('.info-row');
  const empty = document.getElementById('info-empty');

  function applyInfoFilter() {
    const cat = catSel?.value ?? 'all';
    const q = (searchInput?.value ?? '').trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const matchCat = cat === 'all' || row.dataset.cat === cat;
      const matchQ = !q || (row.dataset.title ?? '').toLowerCase().includes(q);
      const show = matchCat && matchQ;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (empty) empty.style.display = visible === 0 ? '' : 'none';
  }

  catSel?.addEventListener('change', applyInfoFilter);
  searchInput?.addEventListener('input', applyInfoFilter);
</script>
