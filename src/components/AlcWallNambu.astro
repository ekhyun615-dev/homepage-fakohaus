---
// AlcWallNambu.astro
---
<div class="alc-wrapper">
  <h4 class="region-h">남부지역 · 제주도 <span class="uv-badge">남부 U ≤ 0.32 · 제주 U ≤ 0.41 W/m²K</span></h4>

  <div class="alc-grid alc-grid-1">
    <!-- Item 1 -->
    <div class="alc-card">
      <div class="alc-uvalue">0.312 W/(m²K)</div>
      <img src="/images/alc-wall-nambu-jeju.webp" alt="알시톱 + ALC (0.5) 30cm" class="zoomable-alc3" title="클릭하여 확대" onerror="this.src='https://placehold.co/180x240/e2e8f0/64748b?text=30cm'" />
      <div class="alc-type">알시톱 + ALC (0.5)</div>
    </div>
  </div>

  <p class="table-note">남부지역: 부산광역시·대구광역시·울산광역시·광주광역시, 전라남도, 경상북도(울진·영덕·포항·경주·청도·경산), 경상남도(거창·함양 제외) · 제주도는 별도 기준 적용</p>
  
  <!-- 이미지 클릭 시 확대 팝업(모달) -->
  <dialog id="img-modal-alc3" class="image-modal">
    <button class="close-btn" aria-label="닫기" id="close-modal-alc3">&times;</button>
    <img id="modal-img-alc3" src="" alt="확대된 이미지" />
  </dialog>
</div>

<script>
  const modalAlc3 = document.getElementById('img-modal-alc3') as HTMLDialogElement;
  const modalImgAlc3 = document.getElementById('modal-img-alc3') as HTMLImageElement;
  const closeBtnAlc3 = document.getElementById('close-modal-alc3');

  if (modalAlc3 && modalImgAlc3 && closeBtnAlc3) {
    const wrapper = document.querySelectorAll('.zoomable-alc3');
    wrapper.forEach(img => {
      img.addEventListener('click', (e) => {
        const target = e.target as HTMLImageElement;
        modalImgAlc3.src = target.src;
        modalAlc3.showModal();
      });
    });

    closeBtnAlc3.addEventListener('click', () => modalAlc3.close());
    modalAlc3.addEventListener('click', (e) => {
      if (e.target === modalAlc3) modalAlc3.close();
    });
  }
</script>

<style>
  .alc-wrapper {
    margin: 5rem 0;
    font-family: inherit;
  }
  .poroton-main-title {
    font-size: 1.8rem;
    font-weight: 800;
    color: #1a202c;
    margin-bottom: 2.5rem;
    letter-spacing: -0.5px;
    text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
  }
  .alc-grid-1 {
    display: flex;
    justify-content: flex-start; /* PC에서는 왼쪽 정렬 */
    margin-bottom: 3rem;
  }
  .alc-card {
    background: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 250px; /* 카드가 너무 넓어지지 않도록 고정폭 */
  }
  .alc-uvalue {
    font-size: 1.15rem;
    font-weight: 800;
    color: #000;
    margin-bottom: 0.4rem;
  }
  .alc-card img {
    width: 100%;
    max-width: 180px;
    height: 220px;
    object-fit: contain;
    margin-bottom: 0.4rem;
    cursor: zoom-in;
    transition: transform 0.2s;
  }
  .alc-card img:hover {
    transform: scale(1.05);
  }
  .alc-type {
    font-size: 1.05rem;
    font-weight: 700;
    color: #000;
    text-align: center;
  }
  
  .alc-region-box {
    margin-top: 1rem;
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 1.2rem;
  }
  .region-box-title {
    color: #3b82f6;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }
  .region-box-desc {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.5;
  }

  /* 팝업 모달 스타일 */
  .image-modal {
    padding: 0;
    border: none;
    border-radius: 8px;
    background: transparent;
    max-width: 90vw;
    max-height: 90vh;
    backdrop-filter: blur(5px);
  }
  .image-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }
  .image-modal img {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    border-radius: 8px;
    background: #fff;
  }
  .close-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    border: none;
    width: 40px;
    height: 40px;
    font-size: 28px;
    line-height: 1;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
  }
  .close-btn:hover {
    background: rgba(0, 0, 0, 0.9);
  }
  
  @media (max-width: 768px) {
    .poroton-main-title {
      font-size: 1.4rem;
      margin-bottom: 1.5rem;
    }
    .alc-grid-1 {
      justify-content: center; /* 모바일에선 중앙 정렬 */
    }
    .alc-uvalue {
      font-size: 1rem;
    }
    .alc-card img {
      height: 180px;
    }
    .alc-type {
      font-size: 0.95rem;
    }
  }
</style>
