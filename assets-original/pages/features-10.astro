---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="10가지 특성 | FAKOHAUS">
  <div class="wrap" style="padding: 80px 0;">
    <div style="text-align: center; margin-bottom: 60px;">
      <span class="eyebrow" style="display:inline-block; margin-bottom: 12px;">FAKOHAUS Eigenschaften</span>
      <h2 class="sec-title">FAKOHAUS의 10가지 특성</h2>
      <p class="sec-lead">독일식 조적 주택이 선사하는 열 가지 핵심 가치를 소개합니다.</p>
    </div>

    <div class="features-grid">
      <!-- 1. 친환경성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Tree Trunk -->
            <path d="M 28 56 L 28 40 M 36 56 L 36 40 M 24 56 L 40 56" stroke="var(--primary)" />
            <!-- Tree Leaves/Bush -->
            <path d="M 28 40 C 14 40, 8 28, 16 18 C 16 6, 32 4, 34 10 C 38 4, 52 6, 50 18 C 58 28, 48 40, 36 40 Z" stroke="var(--primary)" />
            <path d="M 32 46 L 32 26 M 32 32 L 24 22 M 32 36 L 40 26" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>친환경성</h4>
        <p>유해물질 없는 친환경 무기질 자재</p>
      </div>

      <!-- 2. 견고성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Block at the bottom -->
            <rect x="14" y="46" width="36" height="10" rx="1" stroke="var(--primary)" />
            <line x1="22" y1="46" x2="22" y2="56" stroke="var(--accent)" stroke-dasharray="2 2" />
            <line x1="42" y1="46" x2="42" y2="56" stroke="var(--accent)" stroke-dasharray="2 2" />
            <!-- Elephant Full Body -->
            <path d="M 22 46 L 22 34 C 16 34, 12 38, 12 44 C 12 48, 16 50, 16 46 C 16 42, 18 32, 26 26 C 34 20, 46 22, 46 34 L 46 46" stroke="var(--primary)" />
            <!-- Inner Legs / Belly -->
            <path d="M 28 46 L 28 38 C 34 40, 40 38, 40 46" stroke="var(--primary)" />
            <!-- Ear -->
            <path d="M 28 26 C 36 26, 36 38, 28 36 Z" stroke="var(--accent)" />
            <!-- Eye -->
            <circle cx="24" cy="28" r="1.5" fill="var(--primary)" stroke="none" />
            <!-- Tail -->
            <path d="M 46 30 C 50 32, 50 40, 48 44" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>견고성</h4>
        <p>세대를 이어가는 튼튼한 조적조</p>
      </div>

      <!-- 3. 내화성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Crossed Logs -->
            <g stroke="var(--primary)" fill="#fff">
              <rect x="12" y="42" width="28" height="6" rx="3" transform="rotate(-20 26 45)" />
              <rect x="24" y="42" width="28" height="6" rx="3" transform="rotate(20 38 45)" />
            </g>
            <!-- Classic Flame -->
            <path d="M 32 8 C 32 8, 44 24, 44 34 C 44 42, 38 48, 32 48 C 26 48, 20 42, 20 34 C 20 24, 32 8, 32 8 Z" stroke="var(--accent)" />
            <!-- Inner Flame -->
            <path d="M 32 22 C 32 22, 38 30, 38 36 C 38 40, 34 44, 32 44 C 30 44, 26 40, 26 36 C 26 30, 32 22, 32 22 Z" stroke="var(--primary)" />
            <!-- Sparks -->
            <path d="M 18 22 L 16 18 M 46 22 L 48 18 M 32 4 L 32 0" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>내화성</h4>
        <p>불에 타지 않는 불연 무기질 소재</p>
      </div>

      <!-- 4. 폭염차단 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Fan Base & Stand -->
            <path d="M 24 54 L 40 54 M 32 54 L 32 40" stroke="var(--primary)" />
            <!-- Fan Cage -->
            <circle cx="32" cy="24" r="16" stroke="var(--primary)" />
            <circle cx="32" cy="24" r="12" stroke="var(--primary)" stroke-dasharray="2 2" />
            <!-- Fan Center -->
            <circle cx="32" cy="24" r="3" fill="var(--accent)" stroke="none" />
            <!-- Fan Blades -->
            <path d="M 32 21 C 26 12, 38 12, 32 21" stroke="var(--accent)" />
            <path d="M 29 26 C 20 32, 16 22, 29 26" stroke="var(--accent)" />
            <path d="M 35 26 C 44 32, 48 22, 35 26" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>폭염차단</h4>
        <p>한여름 뜨거운 열기를 막는 차단 성능</p>
      </div>

      <!-- 5. 전자기파 차단성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Signal Bars -->
            <rect x="14" y="38" width="6" height="14" rx="1" stroke="var(--primary)" />
            <rect x="24" y="30" width="6" height="22" rx="1" stroke="var(--primary)" />
            <rect x="34" y="22" width="6" height="30" rx="1" stroke="var(--primary)" />
            <rect x="44" y="14" width="6" height="38" rx="1" stroke="var(--primary)" />
            <!-- Accent Sparkles / Waves -->
            <path d="M 10 20 L 14 16 M 16 14 L 20 10 M 22 20 L 26 16 M 32 10 L 36 6" stroke="var(--accent)" stroke-dasharray="2 2" />
          </svg>
        </div>
        <h4>전자기파 차단성</h4>
        <p>외부 유해 전자기파를 차단하는 성능</p>
      </div>

      <!-- 6. 단열성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Beanie Hat Top -->
            <path d="M 12 38 C 12 18, 20 14, 32 14 C 44 14, 52 18, 52 38" stroke="var(--primary)" />
            <!-- Beanie Brim -->
            <rect x="10" y="38" width="44" height="12" rx="2" stroke="var(--primary)" />
            <!-- Brim Lines -->
            <line x1="16" y1="38" x2="16" y2="50" stroke="var(--accent)" />
            <line x1="22" y1="38" x2="22" y2="50" stroke="var(--accent)" />
            <line x1="28" y1="38" x2="28" y2="50" stroke="var(--accent)" />
            <line x1="34" y1="38" x2="34" y2="50" stroke="var(--accent)" />
            <line x1="40" y1="38" x2="40" y2="50" stroke="var(--accent)" />
            <line x1="46" y1="38" x2="46" y2="50" stroke="var(--accent)" />
            <!-- Pom Pom -->
            <circle cx="32" cy="10" r="5" stroke="var(--primary)" />
            <path d="M 29 10 C 29 8, 35 8, 35 10" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>단열성</h4>
        <p>우수한 단열이 빚어내는 포근함</p>
      </div>

      <!-- 7. 차음성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Face Outline -->
            <path d="M 22 26 C 22 14, 42 14, 42 26 C 42 40, 36 50, 32 50 C 28 50, 22 40, 22 26 Z" stroke="var(--accent)" />
            <!-- Earmuff Band -->
            <path d="M 14 30 C 14 10, 50 10, 50 30" stroke="var(--primary)" />
            <!-- Earmuff Cups -->
            <rect x="10" y="24" width="8" height="18" rx="4" fill="#fff" stroke="var(--primary)" />
            <rect x="46" y="24" width="8" height="18" rx="4" fill="#fff" stroke="var(--primary)" />
            <!-- Inner detail -->
            <line x1="14" y1="28" x2="14" y2="38" stroke="var(--accent)" />
            <line x1="50" y1="28" x2="50" y2="38" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>차음성</h4>
        <p>소음을 막아주는 뛰어난 차음 효과</p>
      </div>

      <!-- 8. 내수성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Large Center Drop -->
            <path d="M 32 46 C 42 46, 42 32, 32 20 C 22 32, 22 46, 32 46 Z" stroke="var(--primary)" />
            <!-- Small Drop Left -->
            <path d="M 20 32 C 26 32, 26 24, 20 14 C 14 24, 14 32, 20 32 Z" stroke="var(--accent)" />
            <!-- Small Drop Right -->
            <path d="M 44 32 C 50 32, 50 24, 44 14 C 38 24, 38 32, 44 32 Z" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>내수성</h4>
        <p>습기에 강한 쾌적한 실내 환경</p>
      </div>

      <!-- 9. 경제성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Pig Body -->
            <ellipse cx="34" cy="34" rx="18" ry="14" stroke="var(--primary)" />
            <!-- Snout (left) -->
            <path d="M 16 34 C 10 34, 10 26, 16 26" stroke="var(--primary)" />
            <!-- Legs -->
            <path d="M 24 47 L 24 54 C 24 55, 28 55, 28 54 L 28 47" stroke="var(--primary)" />
            <path d="M 42 47 L 42 54 C 42 55, 46 55, 46 54 L 46 46" stroke="var(--primary)" />
            <!-- Ears -->
            <path d="M 26 21 L 30 12 L 36 21" stroke="var(--primary)" fill="#fff" />
            <!-- Eye -->
            <circle cx="24" cy="28" r="1.5" fill="var(--primary)" stroke="none" />
            <!-- Tail -->
            <path d="M 52 34 C 58 34, 58 28, 54 28 C 50 28, 50 36, 56 36" stroke="var(--accent)" />
            <!-- Coin Slot -->
            <path d="M 38 21 L 46 21" stroke="var(--primary)" stroke-width="2" />
            <!-- Coin -->
            <circle cx="42" cy="10" r="4" stroke="var(--accent)" />
            <path d="M 42 16 L 42 19" stroke="var(--accent)" />
          </svg>
        </div>
        <h4>경제성</h4>
        <p>냉난방비가 절감되는 에너지 효율성</p>
      </div>

      <!-- 10. 가치지속성 -->
      <div class="f-card">
        <div class="f-icon">
          <svg viewBox="0 0 64 64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Trending Line -->
            <path d="M 12 50 L 24 38 L 36 46 L 52 22" stroke="var(--primary)" />
            <!-- Arrow Head -->
            <path d="M 42 22 L 52 22 L 52 32" stroke="var(--primary)" />
            <!-- Grid/Chart Lines (Accent) -->
            <path d="M 12 12 L 12 50 L 52 50" stroke="var(--accent)" stroke-dasharray="2 2" />
          </svg>
        </div>
        <h4>가치지속성</h4>
        <p>시간이 흘러도 변치 않는 주택 가치</p>
      </div>
    </div>
  </div>

  <style>
    .features-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 24px;
      --primary: #1f1d1a; /* 웜 그래파이트 */
      --accent: #ba7224;  /* 로고 오커 */
    }

    .f-card {
      background: #ffffff;
      border: 1px solid #f3f4f6;
      border-radius: 16px;
      /* 두번째 이미지 비율(세로로 긴 카드 형태)에 맞춘 패딩 조정 */
      padding: 48px 24px 40px; 
      text-align: center;
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      height: 100%;
    }

    .f-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.06);
    }

    .f-icon {
      /* 아이콘 영역도 더 큼직하게 조정 */
      width: 84px;
      height: 84px;
      margin-bottom: 24px;
    }

    .f-icon svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .f-card h4 {
      font-size: 19px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 10px;
    }

    .f-card p {
      font-size: 14px;
      color: #6b7280;
      line-height: 1.5;
      margin: 0;
      word-break: keep-all;
    }

    /* Responsive */
    @media (max-width: 1200px) {
      .features-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 900px) {
      .features-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 600px) {
      .features-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 400px) {
      .features-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
